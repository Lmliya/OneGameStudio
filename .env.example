# 是否使用离线 Mock 模式（true 时不调用任何真实模型、不消耗 token）
MOCK_MODE=true

# 真实模式配置（OpenAI 兼容接口），MOCK_MODE=false 时必填
# 模型名必须自己填写，代码里没有写死任何模型名称
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=

# 单次调用超时（秒）
REQUEST_TIMEOUT_SECONDS=30

# 每个员工的阶段最少展示时长（秒），保证驾驶舱动画完整播放；0 表示不等待
STAGE_MIN_SECONDS=6

# ---------- Harness 4：Recovery ----------
# provider 调用异常时的重试次数与指数退避基数（超时不重试）
PROVIDER_MAX_RETRIES=1
PROVIDER_RETRY_BACKOFF_SECONDS=0.5

# ---------- Harness 5：Budget Guard ----------
# 单个任务的预算上限（美元，按下面的估算单价计算，不是真实账单）
BUDGET_USD=1.0
# 已用预算达到该比例后，后续调用优先改用 LIGHT_MODEL
BUDGET_SOFT_RATIO=0.7
# 轻量模型名；留空表示不降级
LIGHT_MODEL=
# 单次调用最大输出 token 数
MAX_OUTPUT_TOKENS=2048
# 模型单价表（JSON）。留空表示没有价格，费用一律标记为 unknown。
# 示例：MODEL_PRICES={"your-model":{"input_per_1k":0.0,"output_per_1k":0.0}}
MODEL_PRICES=
# 并发模型调用上限；预算检查与记账在锁内串行执行，限制并发以防超额
MAX_CONCURRENT_CALLS=1
